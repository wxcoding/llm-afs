#============================================
# AFS 环境配置（本地与生产通用）
# 复制此文件为 .env 并填写实际值
#============================================

# 镜像仓库配置（使用预构建镜像部署时填写，本地构建可忽略）
REGISTRY=cr-xxx.cn-hangzhou.personal.cr.aliyuncs.com
IMAGE_NAME_SERVER=your-namespace/afs-server
IMAGE_NAME_WEB=your-namespace/afs-web
IMAGE_TAG=latest

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=afs
POSTGRES_PORT=5432

# Spring Boot 后端配置
SERVER_PORT=8080
JAVA_OPTS=-Xmx512m -Xms256m

# 前端配置
WEB_PORT=3000

# AI 大模型配置（必填；Chat/Embedding/ReRank 模型需先在百炼控制台开通）
AI_DASHSCOPE_API_KEY=sk-your-api-key-here
AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_DASHSCOPE_MODEL=qwen4-max

# JWT 签名密钥（生产环境必填，建议使用足够长的随机字符串；留空时生产 Compose 会拒绝启动）
JWT_SECRET=

# Redis 配置（可选；留空表示无密码）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
